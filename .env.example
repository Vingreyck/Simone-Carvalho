# Copie para .env e ajuste os valores.

# Postgres. Local (docker compose) usa a porta 5433 pra não brigar com outro Postgres da máquina.
DATABASE_URL="postgresql://doceria:doceria@localhost:5433/doceria?schema=public"

# Segredo que assina o cookie de sessão (32+ bytes aleatórios).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="troque-por-um-valor-aleatorio"

# Usuária inicial criada pelo seed. Troque a senha no primeiro acesso.
SEED_ADMIN_NOME="Simone Carvalho"
SEED_ADMIN_EMAIL="simone@doceria.local"
SEED_ADMIN_SENHA="mudar123"

# Chave da IA (opcional). Liga os atalhos de leitura automática:
#   - foto do cupom fiscal vira compra
#   - foto do caderno vira ficha técnica
#   - conversa do WhatsApp vira pedido
# SEM ela o sistema funciona normalmente — os botões de leitura só não aparecem.
# Pegue em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""
